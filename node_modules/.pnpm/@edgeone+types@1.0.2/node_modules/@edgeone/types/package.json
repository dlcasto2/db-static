{
  "name": "@edgeone/types",
  "version": "1.0.2",
  "description": "EdgeOne Pages function handler types + config types (cloud/node functions, agents, edge functions)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1.d.ts",
      "require": "./dist/v1.js",
      "default": "./dist/v1.js"
    },
    "./v1/types": {
      "types": "./dist/v1/types.d.ts"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "require": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    },
    "./edgeone.schema.json": "./edgeone.schema.json",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "v1": [
        "dist/v1.d.ts"
      ],
      "v1/types": [
        "dist/v1/types.d.ts"
      ],
      "config": [
        "dist/config/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "edgeone.schema.json",
    "README.md"
  ],
  "keywords": [
    "edgeone",
    "tencent",
    "pages",
    "functions",
    "agent",
    "edge",
    "config",
    "typescript",
    "types"
  ],
  "license": "UNLICENSED",
  "scripts": {
    "clean": "rimraf dist edgeone.schema.json",
    "build:js": "esbuild src/index.ts src/v1.ts src/config/index.ts --bundle --platform=node --format=cjs --external:zod --outdir=dist",
    "build:types": "tsc -p tsconfig.json",
    "generate:schema": "node -r esbuild-register ./scripts/generate-schema.ts",
    "build": "npm run clean && npm run generate:schema && npm run build:js && npm run build:types",
    "prepublishOnly": "npm run build && node scripts/verify-schema.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.19.2",
    "esbuild-register": "^3.6.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "zod-to-json-schema": "^3.23.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
