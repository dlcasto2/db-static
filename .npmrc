# This repo commits node_modules (see README), so it only ever needs to run
# on one platform's native binaries. GitHub's runners (and this sandbox) are
# glibc Linux, so skip downloading the musl build of @next/swc entirely —
# without this, pnpm installs both (~125 MB each) because the package can't
# tell at resolve time which libc the eventual host will have.
supportedArchitectures.os[]=current
supportedArchitectures.cpu[]=current
supportedArchitectures.libc[]=glibc
